digraph wiring {
  graph [rankdir=LR, fontname="Helvetica", fontsize=10, compound=true, nodesep=0.22, ranksep=0.55, pad=0.2];
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=7.5, color="#555555", arrowsize=0.6];
  subgraph cluster_power { label="Power input"; style="rounded"; color="#bbbbbb"; fontsize=11;
    "PS1" [shape=record, label="{PS1 24V 5A supply|{<p0>+|<p1>-}}"];
    "F1" [shape=record, label="{F1 5A fuse|{<p0>1|<p1>2}}"];
    "C4" [shape=record, label="{C4 1000uF/35V|{<p0>+|<p1>-}}"];
    "C5" [shape=record, label="{C5 100nF/50V|{<p0>1|<p1>2}}"];
    "F2" [shape=record, label="{F2 0.5A fuse|{<p0>1|<p1>2}}"];
    "PS2" [shape=record, label="{PS2 XL4015 buck|{<p0>IN+|<p1>IN-|<p2>OUT+|<p3>OUT-}}"];
    "C6" [shape=record, label="{C6 10uF/10V|{<p0>+|<p1>-}}"];
  }
  subgraph cluster_mcu { label="MCU and UI"; style="rounded"; color="#bbbbbb"; fontsize=11;
    "U1" [shape=record, label="{U1 ESP32-C3 DevKitM-1|{<p0>5V|<p1>3V3|<p2>GND|<p3>GPIO0|<p4>GPIO1|<p5>GPIO3|<p6>GPIO4|<p7>GPIO5|<p8>GPIO6|<p9>GPIO7|<p10>GPIO10}}"];
    "DS1" [shape=record, label="{DS1 SSD1306 128x64|{<p0>VCC|<p1>GND|<p2>SDA|<p3>SCL}}"];
    "ENC1" [shape=record, label="{ENC1 EC11 encoder|{<p0>A|<p1>B|<p2>C|<p3>SW1|<p4>SW2}}"];
    "BZ1" [shape=record, label="{BZ1 active buzzer|{<p0>+|<p1>-}}"];
  }
  subgraph cluster_front { label="Analog front end"; style="rounded"; color="#bbbbbb"; fontsize=11;
    "U2" [shape=record, label="{U2 ADS1115 0x48|{<p0>VDD|<p1>GND|<p2>SCL|<p3>SDA|<p4>ADDR|<p5>ALRT|<p6>AIN0|<p7>AIN1|<p8>AIN2|<p9>AIN3}}"];
    "U3" [shape=record, label="{U3 MCP6002|{<p0>1 OUT1|<p1>2 -IN1|<p2>3 +IN1|<p3>4 GND|<p4>5 +IN2|<p5>6 -IN2|<p6>7 OUT2|<p7>8 V+}}"];
    "R6" [shape=record, label="{R6 10k|{<p0>1|<p1>2}}"];
    "R7" [shape=record, label="{R7 200k|{<p0>1|<p1>2}}"];
    "R8" [shape=record, label="{R8 1k|{<p0>1|<p1>2}}"];
    "R9" [shape=record, label="{R9 10k|{<p0>1|<p1>2}}"];
    "R10" [shape=record, label="{R10 10k|{<p0>1|<p1>2}}"];
    "C1" [shape=record, label="{C1 1uF/35V|{<p0>1|<p1>2}}"];
    "C2" [shape=record, label="{C2 2.2nF|{<p0>1|<p1>2}}"];
    "C3" [shape=record, label="{C3 100nF|{<p0>1|<p1>2}}"];
    "D1" [shape=record, label="{D1 1N4148|{<p0>A|<p1>K}}"];
    "C7" [shape=record, label="{C7 100nF|{<p0>1|<p1>2}}"];
    "C8" [shape=record, label="{C8 100nF|{<p0>1|<p1>2}}"];
    "C9" [shape=record, label="{C9 100nF|{<p0>1|<p1>2}}"];
  }
  subgraph cluster_heat { label="Heater stage"; style="rounded"; color="#bbbbbb"; fontsize=11;
    "Q1" [shape=record, label="{Q1 IRF4905|{<p0>G|<p1>S|<p2>D}}"];
    "D2" [shape=record, label="{D2 SS54 optional|{<p0>A|<p1>K}}"];
    "R1" [shape=record, label="{R1 2.2k|{<p0>1|<p1>2}}"];
    "R2" [shape=record, label="{R2 2.2k|{<p0>1|<p1>2}}"];
    "R3" [shape=record, label="{R3 4.7k|{<p0>1|<p1>2}}"];
    "R4" [shape=record, label="{R4 10k|{<p0>1|<p1>2}}"];
    "R5" [shape=record, label="{R5 200k|{<p0>1|<p1>2}}"];
    "Q2" [shape=record, label="{Q2 2N2222A|{<p0>B|<p1>C|<p2>E}}"];
    "J1" [shape=record, label="{J1 T12 handle 5-pin|{<p0>P+|<p1>P-|<p2>SW|<p3>E|<p4>NTC}}"];
  }
  "N_GND" [shape=ellipse, style=filled, fillcolor="#f2f2f2", label="GND", fontsize=8];
  "N_+24V" [shape=ellipse, style=filled, fillcolor="#f2f2f2", label="\+24V", fontsize=8];
  "N_+3V3" [shape=ellipse, style=filled, fillcolor="#f2f2f2", label="\+3V3", fontsize=8];
  "N_SDA" [shape=ellipse, style=filled, fillcolor="#f2f2f2", label="SDA", fontsize=8];
  "N_SCL" [shape=ellipse, style=filled, fillcolor="#f2f2f2", label="SCL", fontsize=8];
  "N_TC_OUT" [shape=ellipse, style=filled, fillcolor="#f2f2f2", label="TC_OUT", fontsize=8];
  "N_INV1" [shape=ellipse, style=filled, fillcolor="#f2f2f2", label="INV1", fontsize=8];
  "N_TIP_AMP" [shape=ellipse, style=filled, fillcolor="#f2f2f2", label="TIP_AMP", fontsize=8];
  "N_VREF" [shape=ellipse, style=filled, fillcolor="#f2f2f2", label="VREF", fontsize=8];
  "N_P_LEAD" [shape=ellipse, style=filled, fillcolor="#f2f2f2", label="P_LEAD", fontsize=8];
  "N_GATE" [shape=ellipse, style=filled, fillcolor="#f2f2f2", label="GATE", fontsize=8];
  "N_NPN_B" [shape=ellipse, style=filled, fillcolor="#f2f2f2", label="NPN_B", fontsize=8];
  "PS1":p0 -> "F1":p0 [label="VIN_24"];
  "PS1":p1 -> "N_GND";
  "C4":p1 -> "N_GND";
  "C5":p1 -> "N_GND";
  "PS2":p1 -> "N_GND";
  "PS2":p3 -> "N_GND";
  "C6":p1 -> "N_GND";
  "U1":p2 -> "N_GND";
  "DS1":p1 -> "N_GND";
  "ENC1":p2 -> "N_GND";
  "ENC1":p4 -> "N_GND";
  "BZ1":p1 -> "N_GND";
  "U2":p1 -> "N_GND";
  "U2":p4 -> "N_GND";
  "U3":p3 -> "N_GND";
  "R8":p1 -> "N_GND";
  "R10":p1 -> "N_GND";
  "C1":p1 -> "N_GND";
  "C2":p1 -> "N_GND";
  "C3":p1 -> "N_GND";
  "D1":p0 -> "N_GND";
  "C7":p1 -> "N_GND";
  "C8":p1 -> "N_GND";
  "C9":p1 -> "N_GND";
  "R4":p1 -> "N_GND";
  "Q2":p2 -> "N_GND";
  "J1":p1 -> "N_GND";
  "F1":p1 -> "N_+24V";
  "C4":p0 -> "N_+24V";
  "C5":p0 -> "N_+24V";
  "F2":p0 -> "N_+24V";
  "Q1":p1 -> "N_+24V";
  "D2":p1 -> "N_+24V";
  "R1":p0 -> "N_+24V";
  "R5":p1 -> "N_+24V";
  "F2":p1 -> "PS2":p0 [label="BUCK_IN"];
  "PS2":p2 -> "U1":p0 [label="+5V"];
  "C6":p0 -> "N_+3V3";
  "U1":p1 -> "N_+3V3";
  "DS1":p0 -> "N_+3V3";
  "U2":p0 -> "N_+3V3";
  "U3":p7 -> "N_+3V3";
  "R9":p0 -> "N_+3V3";
  "C7":p0 -> "N_+3V3";
  "C8":p0 -> "N_+3V3";
  "C9":p0 -> "N_+3V3";
  "U1":p3 -> "N_SDA";
  "DS1":p2 -> "N_SDA";
  "U2":p3 -> "N_SDA";
  "U1":p4 -> "N_SCL";
  "DS1":p3 -> "N_SCL";
  "U2":p2 -> "N_SCL";
  "U1":p5 -> "BZ1":p0 [label="BUZZ"];
  "U1":p6 -> "R3":p0 [label="GPIO4"];
  "U1":p7 -> "ENC1":p0 [label="ENC_A"];
  "U1":p8 -> "ENC1":p1 [label="ENC_B"];
  "U1":p9 -> "ENC1":p3 [label="ENC_SW"];
  "U1":p10 -> "J1":p2 [label="SHAKE"];
  "U2":p6 -> "N_TC_OUT";
  "U3":p0 -> "N_TC_OUT";
  "R7":p1 -> "N_TC_OUT";
  "U3":p1 -> "N_INV1";
  "R7":p0 -> "N_INV1";
  "R8":p0 -> "N_INV1";
  "U3":p2 -> "N_TIP_AMP";
  "R6":p1 -> "N_TIP_AMP";
  "C2":p0 -> "N_TIP_AMP";
  "D1":p1 -> "N_TIP_AMP";
  "U3":p4 -> "N_VREF";
  "R9":p1 -> "N_VREF";
  "R10":p0 -> "N_VREF";
  "C3":p0 -> "N_VREF";
  "U3":p5 -> "U3":p6 [label="VREF_BUF"];
  "R6":p0 -> "N_P_LEAD";
  "C1":p0 -> "N_P_LEAD";
  "Q1":p2 -> "N_P_LEAD";
  "D2":p0 -> "N_P_LEAD";
  "J1":p0 -> "N_P_LEAD";
  "Q1":p0 -> "N_GATE";
  "R1":p1 -> "N_GATE";
  "R2":p0 -> "N_GATE";
  "R5":p0 -> "N_GATE";
  "R2":p1 -> "Q2":p1 [label="NPN_C"];
  "R3":p1 -> "N_NPN_B";
  "R4":p0 -> "N_NPN_B";
  "Q2":p0 -> "N_NPN_B";
}
